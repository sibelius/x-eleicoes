# Required in production (any long random string): openssl rand -base64 32
AUTH_SECRET=

# Public URL of the app (callback = $APP_URL/api/auth/x/callback). Defaults to the request origin.
APP_URL=

# X developer app (developer.x.com).
# Preferred: OAuth 1.0a "API Key and Secret" — login returns user id + @handle, no billed API call.
X_API_KEY=
X_API_SECRET=

# Fallback: OAuth 2.0, type "Web App", confidential client.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional, PAID (pay-per-use ~ $0.01 per account returned): fetch following/followers on login.
X_FETCH_FOLLOWS=0
X_FETCH_MAX=100

# Optional, PAID (Apify, ~$0.00015 per account returned, no X login): fetch following/followers
# of the signed-in @handle in the background after login. Takes precedence over X_FETCH_FOLLOWS.
APIFY_TOKEN=
APIFY_FETCH_FOLLOWS=0
APIFY_FETCH_MAX=1000
# Skip the fetch if this user was fetched less than N days ago.
APIFY_REFRESH_DAYS=30

# Free Turso database (turso.tech). Omit locally to use ./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Allow the "test user" login outside dev (keep off in production)
ALLOW_DEV_LOGIN=0
