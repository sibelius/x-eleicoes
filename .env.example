# Required in production (any long random string): openssl rand -base64 32
AUTH_SECRET=

# Public URL of the app (callback = $APP_URL/api/auth/x/callback). Defaults to the request origin.
APP_URL=

# X developer app (developer.x.com) — OAuth 2.0, type "Web App", confidential client.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional, PAID (pay-per-use ~ $0.01 per account returned): fetch following/followers on login.
X_FETCH_FOLLOWS=0
X_FETCH_MAX=100

# Free Turso database (turso.tech). Omit locally to use ./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Allow the "test user" login outside dev (keep off in production)
ALLOW_DEV_LOGIN=0
