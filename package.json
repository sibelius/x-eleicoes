{
  "name": "x-eleicoes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./scripts/with-secrets.sh next dev",
    "build": "next build",
    "start": "./scripts/with-secrets.sh next start",
    "lint": "eslint",
    "secrets:set": "./scripts/secret-set.sh",
    "secrets:list": "./scripts/secret-list.sh",
    "dev:prod-db": "USE_PROD_DB=1 ./scripts/with-secrets.sh next dev",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "db:indexes": "./scripts/with-secrets.sh npx -y tsx scripts/db/indexes.mts",
    "db:check": "./scripts/with-secrets.sh npx -y tsx scripts/db/check-pg.mts",
    "db:copy": "USE_PROD_DB=1 ./scripts/with-secrets.sh npx -y tsx scripts/db/copy-to-pg.mts",
    "db:verify": "USE_PROD_DB=1 ./scripts/with-secrets.sh npx -y tsx scripts/db/verify.mts",
    "places:backfill": "USE_PROD_DB=1 ./scripts/with-secrets.sh npx -y tsx scripts/places/backfill.mts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@reactour/tour": "3.8.0",
    "@vercel/analytics": "1.5.0",
    "@vercel/functions": "3.10.1",
    "@xyflow/react": "^12.12.0",
    "@zip.js/zip.js": "2.18.2",
    "d3-force": "^3.0.0",
    "jose": "^6.2.12",
    "next": "16.4.1",
    "postgres": "3.4.7",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.7",
    "@tailwindcss/turbopack": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright": "1.55.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.9.0"
}
